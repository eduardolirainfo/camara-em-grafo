# Configuração do Neo4j (copie para .env e ajuste a senha)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=troque-esta-senha-local

# Coleta da API de Dados Abertos da Câmara
CAMARA_API_BASE_URL=https://dadosabertos.camara.leg.br/api/v2
CAMARA_ARQUIVOS_BASE_URL=https://dadosabertos.camara.leg.br/arquivos
CAMARA_LEGISLATURA_ID=57
CAMARA_M2_ANOS=2023,2024,2025,2026
CAMARA_M2_TIPOS=PL,PLP,PEC,PDL,PRC
CAMARA_CACHE_DIR=cache
CAMARA_ITENS_POR_PAGINA=100
CAMARA_MAX_CONCORRENCIA=2
CAMARA_PAUSA_SEGUNDOS=0.3
CAMARA_USER_AGENT=camara-em-grafo/0.1 (projeto de estudo de dados abertos)

# API GraphQL (M4)
API_PORT=8001
API_MAX_PROFUNDIDADE=8
API_MAX_CUSTO=200
API_MAX_ITENS_PAGINA=50
API_RATE_LIMIT_REQUISICOES=60
API_RATE_LIMIT_JANELA_SEGUNDOS=60
API_INTROSPECCAO_HABILITADA=true
API_GRAPHIQL_HABILITADO=true
